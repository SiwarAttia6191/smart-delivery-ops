# ── Application ────────────────────────────────────────────────
APP_NAME=Smart Delivery Ops
APP_VERSION=0.1.0
ENVIRONMENT=local

# ── Database ───────────────────────────────────────────────────
# Production stack: PostgreSQL (credentials match docker-compose.yml;
# start it with: docker compose up -d postgres)
DATABASE_URL=postgresql+psycopg://smartops:smartops@localhost:5434/smart_delivery_ops
# Zero-dependency fallback for quick experiments:
# DATABASE_URL=sqlite:///./local.db

# ── Pricing engine (Phase 1) ───────────────────────────────────
# Benchmarked: delivery fees $0.49–$9.99, surge caps 1.2×–2.5× on modern platforms.
PRICING_BASE_FEE=2.00
PRICING_PER_KM=0.90
PRICING_MIN_FEE=3.00
PRICING_SURGE_TIER1_RATIO=1.20
PRICING_SURGE_TIER1_MULTIPLIER=1.25
PRICING_SURGE_TIER2_RATIO=1.50
PRICING_SURGE_TIER2_MULTIPLIER=1.50
PRICING_SURGE_TIER3_RATIO=2.00
PRICING_SURGE_TIER3_MULTIPLIER=2.00

# ── ETA model (Phase 1 heuristic) ──────────────────────────────
# 20 km/h ≈ urban courier travel speed (17–21 km/h benchmark).
ETA_AVG_SPEED_KMH=20.0
ETA_RESTAURANT_PREP_MINUTES=12
ETA_BUFFER_MINUTES=5

# ── Event pipeline (Phase 2) ───────────────────────────────────
# Host tools use the compose host mapping; containers use kafka:19092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_ORDERS_TOPIC=orders.events
# Outbox relay tuning (batch drain / idle poll / failure backoff cap).
RELAY_BATCH_SIZE=100
RELAY_POLL_SECONDS=2.0
RELAY_BACKOFF_SECONDS=60.0
# Warehouse ingestion: separate database from the operational one (dbt builds
# marts on top of the raw layer there).
WAREHOUSE_DATABASE_URL=postgresql+psycopg://smartops:smartops@localhost:5434/smart_delivery_warehouse
KAFKA_GROUP_ID=warehouse-ingest
INGEST_BATCH_SIZE=500
# Airflow failure-alert webhook (empty = log-only fallback in the DAG)
AIRFLOW_ALERT_WEBHOOK=
# ── ML / forecasting (Phase 3) ─────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5100

# ── Business timezone (#78) ────────────────────────────────────
# IANA zone name for local business grains (dbt staging, ML features).
# Storage stays UTC; never use fixed offsets — the tz database knows DST.
BUSINESS_TIMEZONE=Africa/Tunis

# ── Auth (#28) ─────────────────────────────────────────────────
# JWT signing secret for the auth wall — mutating endpoints require a
# Bearer token (GETs stay open in the demo posture). The default below is
# DEV-ONLY; always set your own outside local development.
AUTH_JWT_SECRET=dev-only-change-me
# Token lifetime in minutes (default 12h — a working demo day).
# AUTH_TOKEN_EXPIRE_MINUTES=720
# Demo credentials (after `python scripts/create_user.py --demo`):
#   admin/admin · ops/ops · view/view (viewer is rejected on writes)

# ── Region pack (#78) ──────────────────────────────────────────
# Which city manifest (config/cities/<city>.json) drives seeds, the demo
# map and /config. One deployment = one city; a second side-by-side city
# shifts the host ports (see deploy/cities/paris.env).
CITY=tunis
# OSRM map region: <extract_id>-latest.* files inside OSRM_DATA_DIR.
# Swap region:  python scripts/fetch_osrm_extract.py --region <city>
#   OSRM_EXTRACT_ID=<id> OSRM_DATA_DIR=data/osrm/<id> docker compose run --rm osrm-prepare
OSRM_EXTRACT_ID=tunisia
OSRM_DATA_DIR=./data/osrm
# Host port overrides (defaults: 8010 / 5434 / 9094 / 5000 / 5100 / 8081)
# API_HOST_PORT=8010
# POSTGRES_HOST_PORT=5434
# KAFKA_HOST_PORT=9094
# OSRM_HOST_PORT=5000
# MLFLOW_HOST_PORT=5100
# AIRFLOW_HOST_PORT=8081
