# ── Application ────────────────────────────────────────────────
APP_NAME=Smart Delivery Ops
APP_VERSION=0.1.0
ENVIRONMENT=local

# ── Database ───────────────────────────────────────────────────
# Production stack: PostgreSQL (credentials match docker-compose.yml;
# start it with: docker compose up -d postgres)
DATABASE_URL=postgresql+psycopg://smartops:smartops@localhost:5433/smart_delivery_ops
# Zero-dependency fallback for quick experiments:
# DATABASE_URL=sqlite:///./local.db

# ── Pricing engine (Phase 1) ───────────────────────────────────
PRICING_BASE_FEE=2.00
PRICING_PER_KM=0.90
PRICING_MIN_FEE=3.00
PRICING_SURGE_TIER1_RATIO=1.20
PRICING_SURGE_TIER1_MULTIPLIER=1.25
PRICING_SURGE_TIER2_RATIO=1.50
PRICING_SURGE_TIER2_MULTIPLIER=1.50

# ── ETA model (Phase 1 heuristic) ──────────────────────────────
ETA_AVG_SPEED_KMH=25.0
ETA_RESTAURANT_PREP_MINUTES=12
ETA_BUFFER_MINUTES=5
