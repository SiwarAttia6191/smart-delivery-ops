# ── Application ────────────────────────────────────────────────
APP_NAME=Smart Delivery Ops
APP_VERSION=0.1.0
ENVIRONMENT=local

# ── Database ───────────────────────────────────────────────────
# Production stack: PostgreSQL (credentials match docker-compose.yml;
# start it with: docker compose up -d postgres)
DATABASE_URL=postgresql+psycopg://smartops:smartops@localhost:5434/smart_delivery_ops
# Zero-dependency fallback for quick experiments:
# DATABASE_URL=sqlite:///./local.db

# ── Pricing engine (Phase 1) ───────────────────────────────────
# Benchmarked: delivery fees $0.49–$9.99, surge caps 1.2×–2.5× on modern platforms.
PRICING_BASE_FEE=2.00
PRICING_PER_KM=0.90
PRICING_MIN_FEE=3.00
PRICING_SURGE_TIER1_RATIO=1.20
PRICING_SURGE_TIER1_MULTIPLIER=1.25
PRICING_SURGE_TIER2_RATIO=1.50
PRICING_SURGE_TIER2_MULTIPLIER=1.50
PRICING_SURGE_TIER3_RATIO=2.00
PRICING_SURGE_TIER3_MULTIPLIER=2.00

# ── ETA model (Phase 1 heuristic) ──────────────────────────────
# 20 km/h ≈ urban courier travel speed (17–21 km/h benchmark).
ETA_AVG_SPEED_KMH=20.0
ETA_RESTAURANT_PREP_MINUTES=12
ETA_BUFFER_MINUTES=5

# ── Event pipeline (Phase 2) ───────────────────────────────────
# Host tools use the compose host mapping; containers use kafka:19092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_ORDERS_TOPIC=orders.events
# Outbox relay tuning (batch drain / idle poll / failure backoff cap).
RELAY_BATCH_SIZE=100
RELAY_POLL_SECONDS=2.0
RELAY_BACKOFF_SECONDS=60.0
# Warehouse ingestion: separate database from the operational one (dbt builds
# marts on top of the raw layer there).
WAREHOUSE_DATABASE_URL=postgresql+psycopg://smartops:smartops@localhost:5434/smart_delivery_warehouse
KAFKA_GROUP_ID=warehouse-ingest
INGEST_BATCH_SIZE=500
