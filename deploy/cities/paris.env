# Side-by-side Paris deployment (#78 region pack) — one deployment = one
# city: its own compose project (fresh volumes), shifted host ports, and
# Europe/Paris business grains. The Tunisia demo stack keeps its defaults.
#
#   python scripts/fetch_osrm_extract.py --region paris
#   docker compose --env-file deploy/cities/paris.env -p paris up -d \
#       postgres api worker ingest kafka kafka-init osrm mlflow
#   docker compose --env-file deploy/cities/paris.env -p paris run --rm osrm-prepare
#
# Host-side scripts then point at the shifted ports with the manifest's zone:
#   DATABASE_URL=postgresql+psycopg://smartops:smartops@localhost:5435/smart_delivery_ops \
#   BUSINESS_TIMEZONE=Europe/Paris \
#   python scripts/seed_demo_data.py --region paris
COMPOSE_PROJECT_NAME=paris
BUSINESS_TIMEZONE=Europe/Paris
CITY=paris
OSRM_EXTRACT_ID=ile-de-france
OSRM_DATA_DIR=./data/osrm/ile-de-france
POSTGRES_HOST_PORT=5435
API_HOST_PORT=8011
KAFKA_HOST_PORT=9095
OSRM_HOST_PORT=5001
MLFLOW_HOST_PORT=5110
AIRFLOW_HOST_PORT=8082
